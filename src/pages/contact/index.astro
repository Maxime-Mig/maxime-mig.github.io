---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon from '../../components/Icon.astro';
import { profile } from '../../data/profile';
---

<BaseLayout
  title="Contact"
  hue="ciel"
  description="Contacter Maxime Miguet, développeur jeux vidéo et web : proposition de stage, collaboration ou question sur un projet. Formulaire, adresse e-mail et GitHub."
>
  <PageHeader
    title="Contact"
    lead="Une proposition de stage, une question sur un projet ? Le message arrive directement dans ma boîte mail."
    fortune="La réponse est oui. La question, tu la trouveras plus tard."
    objet="baleine"
  />
  <div class="container page layout">
    <section aria-labelledby="form-title">
      <h2 class="visually-hidden" id="form-title">Formulaire de contact</h2>
      <ContactForm />
    </section>

    <aside class="note on-hue" aria-labelledby="other-title">
      <h2 id="other-title">Sans formulaire</h2>
      <dl>
        <div>
          <dt><Icon name="mail" />E-mail</dt>
          <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
        </div>
        <div>
          <dt><Icon name="github" />GitHub</dt>
          <dd><a href={profile.github} rel="me noopener">{profile.githubHandle}</a></dd>
        </div>
        <div>
          <dt><Icon name="description" />CV</dt>
          <dd><a href={profile.cvPdf} download={profile.cvFileName}>à télécharger en PDF</a></dd>
        </div>
        <div>
          <dt><Icon name="location_on" />Région</dt>
          <dd>{profile.region}</dd>
        </div>
        <div>
          <dt><Icon name="event_available" />Disponibilité</dt>
          <dd>Je prépare mon studio pour 2027, mais je reste ouvert aux propositions de stage.</dd>
        </div>
      </dl>
    </aside>
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 4.5rem;
      padding-top: 11rem;
    }
  }
</style>
