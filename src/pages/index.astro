---
import BaseLayout from '../layouts/BaseLayout.astro';
import CookieHero from '../components/CookieHero.astro';
import Icon from '../components/Icon.astro';
import Objet from '../components/Objet.astro';
import PaperRibbon from '../components/PaperRibbon.astro';
import ProjectPanel from '../components/ProjectPanel.astro';
import { featuredProjects, projects } from '../data/projects';
import { skillGroups, levelLabels } from '../data/skills';
import { profile } from '../data/profile';
import { fr } from '../lib/format';

const layouts = ['wide', 'half', 'half', 'flip'] as const;

const toolbox = ['jeu-video', 'web', 'donnees', 'devops']
  .map((id) => skillGroups.find((group) => group.id === id))
  .filter((group) => group !== undefined)
  .map((group) => ({ ...group, skills: group.skills.slice(0, 4) }));

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: profile.site,
  email: `mailto:${profile.email}`,
  sameAs: [profile.github],
  affiliation: { '@type': 'CollegeOrUniversity', name: profile.school, url: profile.schoolUrl },
  knowsAbout: ['Godot', 'GDScript', 'Développement web', 'Vue.js', 'Node.js', 'WordPress', 'MongoDB', 'GitLab CI/CD'],
  knowsLanguage: ['fr', 'en'],
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Maxime Miguet · Portfolio', url: profile.site, inLanguage: 'fr-FR' };
---

<BaseLayout
  title="Maxime Miguet · Développeur jeux vidéo et web"
  description="Portfolio de Maxime Miguet, développeur jeux vidéo et web en 3e année de BUT Informatique : jeu Godot, sites, API et futur Studio Fortune Cookies."
  type="profile"
  jsonLd={[person, website]}
>
  <div class="home">
    <PaperRibbon />

    <section class="hero band on-hue" data-ribbon-side="right" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-text">
          <h1 id="hero-title">
            <span class="hero-name">Maxime <br />Miguet</span>
            <span class="hero-role">Développeur jeux vidéo et web</span>
          </h1>
          <p>
            {
              fr(
                'Je suis en troisième année de BUT Informatique à l’IUT Nord Franche-Comté, à Belfort. Je développe surtout des jeux vidéo et des sites web. En ce moment, je termine mon jeu Fortune Cookie, que j’aimerais sortir sur Steam.',
              )
            }
          </p>
          <p class="btn-row">
            <a class="btn" href="/projets/">Mes projets</a>
            <a class="icon-link" href={profile.cvPdf} download={profile.cvFileName}><Icon name="download" /><span>Mon CV (PDF)</span></a>
            <a class="icon-link" href={profile.github} rel="me"><Icon name="github" /><span>GitHub</span></a>
          </p>
        </div>

        <div class="hero-cookie">
          <CookieHero />
          <p class="visually-hidden" id="cookie-hint">{fr('Les messages du papier viennent de mon jeu. Cliquez sur le cookie pour en ouvrir un autre.')}</p>
        </div>
      </div>
    </section>

    <section class="section projects" data-ribbon-side="left" aria-labelledby="projects-title">
      <div class="container">
        <h2 class="big" id="projects-title">Projets</h2>
        <div class="panels">
          {featuredProjects.map((project, index) => <ProjectPanel project={project} layout={layouts[index % layouts.length]} />)}
        </div>
        <p class="more"><a class="btn" href="/projets/">Les {projects.length} projets</a></p>
      </div>
    </section>

    <section class="section skills" data-ribbon-side="right" aria-labelledby="skills-title">
      <div class="container">
        <h2 class="big" id="skills-title">Compétences</h2>
        <div class="skill-columns">
          {
            toolbox.map((group) => (
              <div>
                <h3>{group.title}</h3>
                <ul>
                  {group.skills.map((skill) => (
                    <li>
                      <Icon name={skill.icon} />
                      <span>
                        <strong>{skill.name.replace(/ \(.*\)/, '')}</strong>
                        <span class="level">{levelLabels[skill.level]}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="more"><a class="btn" href="/competences/">Toutes mes compétences</a></p>
      </div>
    </section>

    <section class="section about" data-ribbon-side="left" aria-labelledby="about-title">
      <div class="container">
        <div class="about-panel on-hue" data-hue="soleil">
          <div class="about-text">
            <h2 class="big" id="about-title">À propos</h2>
            <p>
              {
                fr(
                  'Je suis entré en BUT en 2024, après un bac avec les spécialités maths et NSI. Je joue beaucoup aux jeux vidéo et j’écoute énormément de musique, et c’est en grande partie ce qui m’a donné envie de développer.',
                )
              }
            </p>
            <p>
              {
                fr(
                  'Pendant la formation, j’ai surtout travaillé en équipe, par exemple à cinq sur une application pour un événement médiéval. Mon stage de deuxième année chez Good Geek m’a ensuite appris à réaliser seul un site complet, des maquettes jusqu’aux dernières corrections.',
                )
              }
            </p>
            <p>
              {
                fr(
                  'J’ai obtenu le statut national d’étudiant-entrepreneur pour créer mon studio de jeux, Fortune Cookies, en 2027. Je reste ouvert aux propositions de stage.',
                )
              }
            </p>
            <p class="more"><a class="btn" href="/a-propos/">Mon parcours</a></p>
          </div>
          <Objet name="cookie-chat" class="about-cat" sizes="(min-width: 900px) 440px, 70vw" />
        </div>
      </div>
    </section>

    <section class="contact band on-hue" data-hue="ciel" aria-labelledby="contact-title">
      <div class="container contact-grid">
        <div class="slip end" data-ribbon-end>
          <h2 id="contact-title">Me contacter</h2>
          <p>
            <a class="icon-link" href={`mailto:${profile.email}`}><Icon name="mail" /><span>{profile.email}</span></a><br />
            <a class="icon-link" href="/contact/"><Icon name="send" /><span>Formulaire de contact</span></a>
          </p>
        </div>
        <Objet name="baleine" class="whale" sizes="(min-width: 1100px) 620px, 90vw" />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    position: relative;
    isolation: isolate;
  }

  /* Aplat pleine largeur, peint sous le ruban. */
  .band {
    position: relative;
    color: var(--hue-ink);
  }

  .band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--hue);
  }

  .band > .container {
    position: relative;
    z-index: 1;
  }

  .hero-grid {
    padding-block: 1.5rem 2rem;
  }

  h1 {
    margin: 0;
  }

  .hero-name,
  .hero-role {
    display: block;
  }

  .hero-name {
    font-size: clamp(4rem, 23vw, 10rem);
    padding-bottom: 0.27em;
    line-height: 0.84;
    letter-spacing: -0.015em;
  }

  .hero-role {
    margin: 0 0 0.6rem;
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .hero-text .btn-row {
    margin: 1.5rem 0 0;
  }

  .hero-cookie {
    width: min(100%, 520px);
    margin: 2.5rem auto 0;
  }

  .big {
    margin-bottom: 0.45em;
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 0.95;
  }

  .projects {
    margin-top: 14rem;
  }

  .skills,
  .about {
    margin-top: 10rem;
  }

  .contact {
    margin-top: 6rem;
  }

  /* Le papier du cookie est bien plus large que le ruban : il lui faut de la place pour
     s'affiner avant de traverser. */
  @media (min-width: 1500px) {
    .projects {
      margin-top: 16rem;
    }
  }

  .panels {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .more {
    margin: 2rem 0 0;
  }

  @media (min-width: 860px) {
    .panels {
      grid-template-columns: 1fr 1fr;
    }

    .panels > :global(.panel-wide),
    .panels > :global(.panel-flip) {
      grid-column: 1 / -1;
    }
  }

  .skill-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 235px), 1fr));
    gap: 2.5rem 2rem;
  }

  .skill-columns ul {
    display: grid;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-columns li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    line-height: 1.25;
  }

  .skill-columns li :global(.icon) {
    width: 1em;
    font-size: 2.3rem;
  }

  .skill-columns strong,
  .level {
    display: block;
  }

  .level {
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .about-panel {
    display: grid;
    overflow: hidden;
    border-radius: var(--round);
    background: var(--hue);
    color: var(--hue-ink);
  }

  .about-text {
    max-width: 44rem;
    padding: clamp(1.75rem, 4vw, 3.5rem);
  }

  .about-panel :global(.about-cat) {
    width: min(80%, 380px);
    margin: 0 auto -3rem;
  }

  @media (min-width: 900px) {
    .about-panel {
      grid-template-columns: minmax(0, 1fr) 38%;
      align-items: end;
    }

    .about-panel :global(.about-cat) {
      width: 118%;
      max-width: none;
      margin: 0 0 -3.5rem -6%;
    }
  }

  .contact-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: 6rem 3rem;
  }

  /* Le bout du ruban (PaperRibbon) : il lui faut de la place pour se plier en accordéon, au-dessus
     sur téléphone, à gauche ailleurs. */
  .end {
    position: relative;
    width: fit-content;
    max-width: 100%;
    margin-top: 12rem;
    padding: 2.25rem 1.5rem 1.9rem;
  }

  .end.is-attached {
    background: none;
    box-shadow: none;
  }

  @media (min-width: 760px) {
    .end {
      margin-top: 0;
      margin-left: max(0px, clamp(260px, 26vw, 370px) - (100vw - min(100vw - 2 * var(--gutter), var(--container))) / 2);
      padding-inline: 2.5rem;
    }
  }

  .end h2 {
    margin-bottom: 0.4em;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    white-space: nowrap;
  }

  .end p {
    margin: 0;
    font-size: clamp(0.85rem, 3.9vw, 1.125rem);
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .end a {
    font-weight: 400;
  }

  .contact-grid :global(.whale) {
    justify-self: end;
    width: min(100%, 600px);
  }

  @media (min-width: 1100px) {
    .contact-grid {
      grid-template-columns: auto minmax(0, 1fr);
      padding-block: 8rem 6rem;
    }

    .contact-grid :global(.whale) {
      justify-self: start;
      width: calc(100% + 4rem);
      max-width: none;
    }
  }

  @media (min-width: 900px) {
    /* La scène occupe la moitié droite de l'écran, calée sur le bord droit. */
    .hero-grid {
      display: flex;
      align-items: center;
      min-height: clamp(600px, min(100svh - var(--header-height), 68vw), 900px);
    }

    .hero-text {
      position: relative;
      z-index: 2;
      max-width: min(31rem, 40vw);
      pointer-events: none;
    }

    .hero-text a {
      pointer-events: auto;
    }

    .hero-name {
      font-size: clamp(6rem, min(13.2vw, 26svh), 13.5rem);
      white-space: nowrap;
    }

    .hero-cookie {
      position: absolute;
      right: calc((100% - 100vw) / 2 + 3.2vw);
      bottom: 1.5rem;
      width: min(44vw, 98svh - var(--header-height), 780px);
      margin: 0;
    }
  }
</style>
