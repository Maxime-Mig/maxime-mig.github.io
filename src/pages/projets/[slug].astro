---
import { Image } from 'astro:assets';
import { Code } from 'astro:components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import Icon from '../../components/Icon.astro';
import Objet from '../../components/Objet.astro';
import { projects, type Project } from '../../data/projects';
import { profile } from '../../data/profile';
import { fr, rich } from '../../lib/format';
import { techIcon } from '../../lib/icons';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(index - 1 + projects.length) % projects.length],
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}

const { project, prev, next } = Astro.props;

const url = new URL(`/projets/${project.slug}/`, profile.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: project.title,
    headline: project.tagline,
    description: project.summary,
    url,
    inLanguage: 'fr-FR',
    keywords: project.stack.join(', '),
    author: { '@type': 'Person', name: profile.name, url: profile.site },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${profile.site}/` },
      { '@type': 'ListItem', position: 2, name: 'Projets', item: `${profile.site}/projets/` },
      { '@type': 'ListItem', position: 3, name: project.title, item: url },
    ],
  },
];
---

<BaseLayout title={project.title} hue={project.hue} description={project.summary} jsonLd={jsonLd}>
  <article>
    <header class:list={['project-hero', 'on-hue', { 'has-cover': project.cover }]}>
      <div class="container">
        <div>
          <nav class="breadcrumbs" aria-label="Fil d’Ariane">
            <ol>
              <li><a href="/">Accueil</a></li>
              <li><a href="/projets/">Projets</a></li>
              <li aria-current="page">{project.title}</li>
            </ol>
          </nav>
          <h1>{project.title}</h1>
          <p class="lead">{fr(project.tagline)}</p>
        </div>
        {project.objet && <Objet name={project.objet} class="project-objet" eager />}
      </div>
    </header>

    <!--
      Ordre de lecture (consigne, figure 11) : d'abord l'image et un texte clair pour tous,
      puis la fiche (contexte, technologies, lien vers le code), puis le détail technique.
      Sur grand écran, la fiche passe dans la colonne de droite.
    -->
    <div class="container project-body">
      {
        project.cover && (
          <figure class:list={['project-cover', { tall: project.cover.src.height > project.cover.src.width }]}>
            <Image
              src={project.cover.src}
              alt={project.cover.alt}
              widths={[480, 720, 960, 1280, 1600].filter((width) => width <= project.cover!.src.width)}
              sizes="(min-width: 1260px) 1180px, 92vw"
              loading="eager"
            />
            <figcaption>{fr(project.cover.caption)}</figcaption>
          </figure>
        )
      }
    <div class="project-layout">
      <section class="project-intro" aria-labelledby="brief-title">
        <h2 id="brief-title">Présentation</h2>
        {project.description.map((paragraph) => <p set:html={rich(paragraph)} />)}
      </section>

      <aside class="project-aside" aria-labelledby="sheet-title">
        <div class="note on-hue">
            <h2 id="sheet-title">Fiche du projet</h2>
            <dl>
              <div>
                <dt><Icon name="category" />Type</dt>
                <dd>{project.kind}</dd>
              </div>
              <div>
                <dt><Icon name="calendar_month" />Période</dt>
                <dd>{fr(project.period)}</dd>
              </div>
              <div>
                <dt><Icon name="school" />Cadre</dt>
                <dd>{fr(project.setting)}</dd>
              </div>
              <div>
                <dt><Icon name="group" />Équipe</dt>
                <dd>{fr(project.team)}</dd>
              </div>
              <div>
                <dt><Icon name="handyman" />Technologies</dt>
                <dd>
                  <ul class="stack" role="list">
                    {project.stack.map((tech) => {
                      const logo = techIcon(tech);
                      return (
                        <li>
                          {logo && <Icon name={logo} />}
                          {tech}
                        </li>
                      );
                    })}
                  </ul>
                </dd>
              </div>
              <div>
                <dt><Icon name="code" />Code</dt>
                <dd>
                  {project.links?.map((link) => (
                    <a class="sheet-link" href={link.href} rel="noopener">
                      <span>{link.label}</span>
                      <span class="visually-hidden"> (site externe)</span>
                    </a>
                  ))}
                  {project.linkNote && fr(project.linkNote)}
                </dd>
              </div>
            </dl>
        </div>
      </aside>

      <div class="project-main">
        <section class="block" aria-labelledby="features-title">
          <h2 id="features-title">Fonctionnalités</h2>
          <ul class="list">
            {
              project.features.map((feature) => (
                <li>{fr(feature)}</li>
              ))
            }
          </ul>
        </section>

        <section class="block" aria-labelledby="role-title">
          <h2 id="role-title">Mon rôle</h2>
          <p>{fr(project.role.intro)}</p>
          {
            project.role.items && (
              <ul class="list">
                {project.role.items.map((item) => (
                  <li>{fr(item)}</li>
                ))}
              </ul>
            )
          }
        </section>

        {
          project.gallery && (
            <section class="block" aria-labelledby="gallery-title">
              <h2 id="gallery-title">Images</h2>
              <Gallery shots={project.gallery} />
            </section>
          )
        }

        {
          project.tracks && (
            <section class="block" aria-labelledby="audio-title">
              <h2 id="audio-title">Extraits audio</h2>
              <p>{fr('Le même enregistrement, après chaque étape du Pauvocodeur. Le son ne se lance que si vous appuyez sur lecture.')}</p>
              <ul class="tracks" role="list">
                {project.tracks.map((track, index) => (
                  <li class="track">
                    <p class="track-title" id={`track-${index}`}>
                      {fr(track.title)}
                    </p>
                    <p class="track-text">{fr(track.text)}</p>
                    <audio controls preload="none" src={track.src} aria-labelledby={`track-${index}`}>
                      <a href={track.src}>Écouter l’extrait (MP3)</a>
                    </audio>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="block" aria-labelledby="challenges-title">
          <h2 id="challenges-title">Difficultés rencontrées</h2>
          <dl class="challenges">
            {
              project.challenges.map((challenge) => (
                <div>
                  <dt>{fr(challenge.problem)}</dt>
                  <dd>{fr(challenge.solution)}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        {
          project.learned && (
            <section class="block" aria-labelledby="learned-title">
              <h2 id="learned-title">Ce que j’ai appris</h2>
              <ul class="list">
                {project.learned.map((item) => (
                  <li>{fr(item)}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          project.next && (
            <section class="block" aria-labelledby="next-title">
              <h2 id="next-title">Suite du projet</h2>
              <ul class="list">
                {project.next.map((item) => (
                  <li>{fr(item)}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          (project.technical || project.code) && (
            <section class="block" aria-labelledby="tech-title">
              <h2 id="tech-title">Détails techniques</h2>
              {project.technical && (
                <ul class="list">
                  {project.technical.map((item) => (
                    <li>{fr(item)}</li>
                  ))}
                </ul>
              )}
              {project.code && (
                <figure class="code-sample">
                  <Code code={project.code.content} lang={project.code.lang} theme="github-dark-dimmed" />
                  <figcaption>{fr(project.code.label)}</figcaption>
                </figure>
              )}
            </section>
          )
        }

      </div>
    </div>

    <nav class="pager" aria-label="Autres projets">
      {
        [
          { label: 'Projet précédent', rel: 'prev', project: prev },
          { label: 'Projet suivant', rel: 'next', project: next },
        ].map((link) => (
          <a class="pager-link" href={`/projets/${link.project.slug}/`} rel={link.rel} data-hue={link.project.hue}>
            <span>{link.label}</span>
            <strong>{link.project.title}</strong>
          </a>
        ))
      }
    </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .project-hero {
    background: var(--hue);
    color: var(--hue-ink);
  }

  .project-hero .container {
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 5vw, 4rem);
  }

  .project-hero .lead {
    margin: 0;
  }

  /* La capture chevauche le bas de l'aplat. */
  .has-cover .container {
    padding-bottom: clamp(9rem, 24vw, 19rem);
  }

  .project-hero :global(.project-objet) {
    width: min(70%, 300px);
    margin: 2rem auto -5rem;
  }

  @media (min-width: 900px) {
    .project-hero:not(.has-cover) .container {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 2rem;
      align-items: end;
      min-height: 400px;
    }

    .project-hero :global(.project-objet) {
      width: 340px;
      margin: 0 0 -9rem;
    }
  }

  .project-body {
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .project-cover {
    margin: calc(-1 * clamp(7rem, 20vw, 16rem)) 0 0;
  }

  .project-cover :global(img) {
    width: 100%;
    border-radius: var(--round);
  }

  .project-cover.tall {
    width: min(100%, 640px);
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .project-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  @media (min-width: 1000px) {
    .project-layout {
      grid-template-columns: minmax(0, 1fr) 340px;
      grid-template-rows: auto 1fr;
      column-gap: 4.5rem;
      row-gap: 3.5rem;
      align-items: start;
    }

    .project-aside {
      grid-column: 2;
      grid-row: 1 / span 2;
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
    }

    .project-main {
      grid-column: 1;
    }
  }

  .project-intro > :last-child {
    margin-bottom: 0;
  }

  .project-intro p:first-of-type {
    font-size: clamp(1.15rem, 1.8vw, 1.3rem);
    line-height: 1.5;
  }

  .project-aside .stack {
    gap: 0.15rem 0.9rem;
  }

  .sheet-link {
    display: inline-block;
    padding-block: 0.3rem;
  }

  .block {
    margin-bottom: 3.5rem;
  }

  .list {
    margin: 0;
  }

  .list li {
    margin-bottom: 0.45rem;
  }

  .challenges {
    display: grid;
    gap: 1.5rem;
    margin: 0;
  }

  .challenges dt {
    font-weight: 700;
  }

  .challenges dd {
    margin: 0.2rem 0 0;
  }

  .code-sample {
    margin: 1.5rem 0 0;
  }

  .code-sample :global(pre) {
    margin: 0;
    padding: 1.25rem 1.4rem;
    border-radius: 18px;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .tracks {
    display: grid;
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .track-title {
    margin: 0;
    font-weight: 700;
  }

  .track-text {
    margin: 0;
  }

  .track audio {
    width: 100%;
    margin-top: 0.35rem;
  }

  .pager {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: 2rem;
  }

  .pager-link {
    display: grid;
    align-content: end;
    gap: 0.3rem;
    min-height: 11rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--round);
    background: var(--hue);
    color: var(--hue-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .pager-link strong {
    font-family: var(--font-title);
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 400;
    line-height: 1.05;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.16em;
  }

  .pager-link:hover {
    background: var(--hue-ink);
    color: var(--hue);
  }

  @media (min-width: 700px) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
