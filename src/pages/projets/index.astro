---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectPanel from '../../components/ProjectPanel.astro';
import { projects } from '../../data/projects';

const layouts = ['wide', 'half', 'half', 'flip', 'half', 'half'] as const;
---

<BaseLayout
  title="Projets"
  hue="lilas"
  description="Projets de Maxime Miguet : jeu Godot en route vers Steam, stage WordPress, blind test en temps réel et sept projets universitaires."
>
  <PageHeader
    title="Projets"
    lead="Un jeu, un stage, un blind test et sept projets universitaires."
    fortune="Ce cookie vaut double. Il a fait des études."
    objet="cookie-chat"
  />
  <div class="container page panels">
    {projects.map((project, index) => <ProjectPanel project={project} headingLevel="h2" layout={layouts[index % layouts.length]} eager={index === 0} />)}
  </div>
</BaseLayout>

<style>
  .panels {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  @media (min-width: 860px) {
    .panels {
      grid-template-columns: 1fr 1fr;
      padding-top: 8rem;
    }

    .panels > :global(.panel-wide),
    .panels > :global(.panel-flip) {
      grid-column: 1 / -1;
    }
  }
</style>
