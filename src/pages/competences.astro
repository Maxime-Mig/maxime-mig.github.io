---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import Objet from '../components/Objet.astro';
import { skillGroups, softSkills, levelLabels, type Level } from '../data/skills';
import { projectBySlug } from '../data/projects';
import { fr } from '../lib/format';

const levels = Object.keys(levelLabels).map(Number).reverse() as Level[];
const levelHints: Record<Level, string> = {
  3: 'je l’utilise souvent et je saurais l’expliquer à quelqu’un',
  2: 'je l’ai utilisé dans un projet, avec la documentation à côté',
  1: 'j’en connais les bases, vues en cours ou en TP',
};
---

<BaseLayout
  title="Compétences"
  hue="menthe"
  description="Compétences de Maxime Miguet : Godot, HTML, CSS, Vue, Node.js, WordPress, SQL, MongoDB, GitLab CI/CD, Docker, Java, Python. Chaque niveau vient d’un projet."
>
  <PageHeader title="Compétences" fortune="Si tu lis ceci, tu sais lire. Bravo.">
    <dl class="legend">
      {
        levels.map((level) => (
          <div>
            <dt><span class:list={['chip', `chip-${level}`]}>{levelLabels[level]}</span></dt>
            <dd>{fr(levelHints[level])}</dd>
          </div>
        ))
      }
    </dl>
    <Fragment slot="scene">
      <Objet name="maillet" class="arm arm-1" eager />
      <Objet name="poele" class="arm arm-2" eager />
      <Objet name="cuillere" class="arm arm-3" eager />
    </Fragment>
  </PageHeader>

  <div class="container page">
    {
      skillGroups.map((group) => (
        <section class="section group" aria-labelledby={`group-${group.id}`}>
          <h2 id={`group-${group.id}`}>{group.title}</h2>
          <ul class="skills" role="list">
            {group.skills.map((skill) => {
              // Seuls les projets publiés sur le site sont cités.
              const seenIn = (skill.projects ?? []).map((slug) => projectBySlug(slug)).filter((project) => project !== undefined);
              return (
                <li>
                  <Icon name={skill.icon} />
                  <div>
                    <h3>{skill.name}</h3>
                    <span class:list={['chip', `chip-${skill.level}`]}>{levelLabels[skill.level]}</span>
                    <p>
                      {fr(skill.proof)}
                      {seenIn.length > 0 && (
                        <span class="seen">
                          {seenIn.map((project, index) => [index > 0 && ', ', <a href={`/projets/${project.slug}/`}>{project.title}</a>])}
                        </span>
                      )}
                    </p>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <section class="section group" aria-labelledby="soft-title">
      <h2 id="soft-title">Compétences humaines</h2>
      <dl class="soft">
        {
          softSkills.map((skill) => (
            <div>
              <dt>{fr(skill.name)}</dt>
              <dd>{fr(skill.proof)}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</BaseLayout>

<style>
  .legend {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }

  .legend > div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.75rem;
  }

  .legend dd {
    margin: 0;
  }

  /* Trois niveaux, trois remplissages. */
  .chip {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border: 2px solid var(--chip, var(--ink));
    border-radius: 9px;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .legend .chip {
    --chip: var(--hue-ink);
    --chip-bg: var(--hue);
    width: 11.5rem;
    text-align: center;
  }

  .chip-3 {
    background: var(--chip, var(--ink));
    color: var(--chip-bg, var(--bg));
  }

  .chip-2 {
    border-color: transparent;
    background: var(--hue);
    color: var(--hue-ink);
  }

  .legend .chip-2 {
    background: color-mix(in srgb, var(--hue-ink) 20%, transparent);
  }

  /* Trois bras du jeu entrent par la droite de l'écran. */
  :global(.arm) {
    position: absolute;
    max-width: none;
  }

  :global(.scene:has(.arm)) {
    min-height: 260px;
  }

  :global(.arm-1) {
    left: 26%;
    bottom: 30%;
    width: 95%;
  }

  :global(.arm-2) {
    left: 4%;
    bottom: 18%;
    width: 120%;
  }

  :global(.arm-3) {
    display: none;
  }

  @media (min-width: 900px) {
    .page {
      padding-top: 7rem;
    }

    .group {
      display: grid;
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }

    .group h2 {
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
      margin: 0;
      hyphens: manual;
    }

    :global(.scene:has(.arm)) {
      min-height: 320px;
    }

    :global(.arm-1) {
      left: 22%;
      bottom: 72%;
      width: 150%;
    }

    :global(.arm-2) {
      left: 4%;
      bottom: 13%;
      width: 170%;
    }

    :global(.arm-3) {
      display: block;
      left: -16%;
      bottom: 48%;
      width: 190%;
    }
  }

  .group h2 {
    font-size: clamp(2rem, 3.6vw, 2.7rem);
  }

  .skills {
    display: grid;
    gap: 2.25rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skills li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1.1rem;
    align-items: start;
  }

  .skills li > :global(.icon) {
    width: 1em;
    font-size: 3rem;
  }

  .skills h3 {
    margin-bottom: 0.4rem;
    font-size: 1.35rem;
  }

  .skills p {
    margin: 0.55rem 0 0;
    line-height: 1.5;
  }

  .seen {
    display: block;
  }

  .soft {
    display: grid;
    gap: 1.75rem 2.5rem;
    margin: 0;
  }

  .soft dt {
    font-family: var(--font-title);
    font-size: 1.35rem;
    line-height: 1.1;
  }

  .soft dd {
    margin: 0.4rem 0 0;
    line-height: 1.5;
  }

  @media (min-width: 700px) {
    .skills,
    .soft {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
