---
import { profile } from '../data/profile';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer on-hue">
  <ul class="container">
    <li class="who">Maxime Miguet, {year}</li>
    <li><a class="icon-link" href={`mailto:${profile.email}`}><Icon name="mail" /><span>{profile.email}</span></a></li>
    <li><a class="icon-link" href={profile.github} rel="me"><Icon name="github" /><span>GitHub</span></a></li>
    <li><a class="icon-link" href="/cv/"><Icon name="description" /><span>CV en ligne</span></a></li>
    <li><a href="/confidentialite/">Mentions légales</a></li>
  </ul>
</footer>

<style>
  .site-footer {
    padding: 2.25rem 0;
    background: var(--hue);
    color: var(--hue-ink);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.75rem;
    padding: 0;
    list-style: none;
    font-size: 1rem;
  }

  .who {
    margin-right: auto;
    font-family: var(--font-title);
    font-size: 1.2rem;
  }

  a {
    padding-block: 0.4rem;
    overflow-wrap: anywhere;
  }

  a:not(.icon-link) {
    display: inline-block;
  }
</style>
