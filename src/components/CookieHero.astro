---
// Le fortune cookie de l'accueil : le modèle 3D du jeu Fortune Cookie, rendu avec la lumière
// et la caméra de son écran titre (cookie entier, sans papier visible, puis ses deux moitiés,
// dans le même cadre), avec le doigt (premier outil du jeu) et le pigeon. Le doigt casse le cookie au
// chargement, puis à chaque clic. Le papier, au style des papiers du jeu, se prolonge par le ruban
// qui descend le long de la page (PaperRibbon).
import { getImage } from 'astro:assets';
import Objet from './Objet.astro';
import cookieWhole from '../assets/cookie/cookie-ferme.webp';
import cookieLeft from '../assets/cookie/cookie-casse-gauche.webp';
import cookieRight from '../assets/cookie/cookie-casse-droite.webp';
import { fortunes } from '../data/fortunes';
import { fr } from '../lib/format';

const first = fortunes[0];
const payload = JSON.stringify(fortunes.map((text) => fr(text)));

const sizes = '(min-width: 900px) 38vw, 70vw';
const [whole, left, right] = await Promise.all(
  [cookieWhole, cookieLeft, cookieRight].map((src) => getImage({ src, widths: [340, 620, 900], sizes, format: 'webp' })),
);

// Miettes qui sautent de la fissure. Unités en pour cent de la largeur du cookie : départ le
// long de la fissure (x, y), distance parcourue (dx), hauteur du saut (up), rotation, taille,
// forme et retard. Elles retombent toutes sur la table, à la hauteur de l'ombre.
const crumbs = [
  [2, -10, -38, -14, 220, 1.2, 'a', 0],
  [3, -12, 30, -18, -260, 1, 'b', 10],
  [-2, -2, -26, -10, 180, 0.8, 'c', 0],
  [0, -6, 42, -12, 300, 1.3, 'a', 20],
  [-5, 6, -48, -6, -200, 0.9, 'b', 0],
  [-4, 4, 18, -16, 140, 0.6, 'c', 30],
  [-8, 14, -30, -4, 260, 1.1, 'a', 10],
  [-9, 18, 12, -8, -320, 0.7, 'b', 40],
  [1, -8, 54, -6, 120, 0.8, 'c', 0],
  [-6, 10, -58, -10, -150, 0.6, 'a', 20],
  [-10, 22, -14, -2, 90, 1, 'c', 50],
  [0, -4, 8, -22, -400, 0.5, 'b', 0],
] as const;
// La table est à 86 % de la largeur sous le haut du cookie ; la fissure part de 19 %.
const table = 67;
---

<div class="cookie-hero" data-fortunes={payload}>
  <div class="cookie-scene">
    <span class="cookie-shadow" aria-hidden="true"></span>

    <button class="cookie-stage" type="button" aria-label="Casser un autre fortune cookie" aria-describedby="cookie-hint">
      <img class="cookie-img cookie-whole" src={whole.src} srcset={whole.srcSet.attribute} sizes={sizes} width={cookieWhole.width} height={cookieWhole.height} alt="" draggable="false" />
      <img class="cookie-img cookie-half cookie-left" src={left.src} srcset={left.srcSet.attribute} sizes={sizes} width={cookieLeft.width} height={cookieLeft.height} alt="" draggable="false" />
      <img class="cookie-img cookie-half cookie-right" src={right.src} srcset={right.srcSet.attribute} sizes={sizes} width={cookieRight.width} height={cookieRight.height} alt="" draggable="false" />
      <span class="crumbs" aria-hidden="true">
        {
          crumbs.map(([x, y, dx, up, r, size, shape, delay], index) => (
            <span
              class="crumb"
              style={`--x:${x}cqw;--y:${y}cqw;--dx:${dx}cqw;--up:${up}cqw;--land:${table - y + ((index % 3) - 1) * 2}cqw;--r:${r}deg;--s:${size};--delay:${delay}ms`}
            >
              <span class:list={['crumb-bit', `crumb-${shape}`]} />
            </span>
          ))
        }
      </span>
    </button>

    <div class="arm" aria-hidden="true"><Objet name="doigt" sizes="(min-width: 900px) 104vw, 166vw" eager /></div>
    <div class="pigeon" aria-hidden="true"><Objet name="pigeon-droite" sizes="(min-width: 900px) 20vw, 30vw" eager /></div>

    <div class="fortune" data-ribbon-start>
      <p class="fortune-text" aria-live="polite">{fr(first)}</p>
    </div>
  </div>
</div>

<script>
  const hero = document.querySelector<HTMLElement>('.cookie-hero');

  if (hero) {
    const stage = hero.querySelector<HTMLButtonElement>('.cookie-stage')!;
    const text = hero.querySelector<HTMLElement>('.fortune-text')!;
    const fortunes: string[] = JSON.parse(hero.dataset.fortunes ?? '[]');
    const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
    let current = 0;
    let busy = false;

    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, motion.matches ? ms : 0));

    // Prévient le ruban : il part du bout droit du papier, qui peut avoir changé de taille.
    const announceOpen = () => {
      hero.dataset.opened = 'true';
      hero.dispatchEvent(new CustomEvent('cookie:open', { bubbles: true }));
    };

    // Les papiers sont choisis à l'avance : toujours dans l'ordre de la liste, puis on recommence.
    const pickFortune = () => {
      current = (current + 1) % fortunes.length;
      return fortunes[current] ?? '';
    };

    // Le doigt appuie, le cookie s'écrase un peu, se fend, puis claque en deux.
    const breakCookie = async () => {
      hero.classList.add('is-shaking');
      await wait(240);
      hero.classList.replace('is-shaking', 'is-cracking');
      await wait(60);
      hero.classList.remove('is-cracking');
      hero.classList.add('is-open', 'has-paper');
    };

    // Un nouveau cookie arrive entier, se casse, et le papier change de message. Le papier
    // reste en place pendant ce temps : le ruban qui en sort ne se retrouve jamais sans attache.
    stage.addEventListener('click', async () => {
      if (busy) return;
      busy = true;
      const next = pickFortune();
      if (motion.matches) {
        hero.classList.add('is-changing');
        hero.classList.remove('is-open');
        await wait(380);
        // Le texte est caché pendant le changement : le ruban a le temps de s'adapter si le
        // papier change de hauteur.
        text.textContent = next;
        announceOpen();
        await breakCookie();
        hero.classList.remove('is-changing');
        await wait(300);
      } else {
        text.textContent = next;
        announceOpen();
      }
      busy = false;
    });

    // Sur mobile, le cookie est sous le texte : on attend qu'il soit visible
    // pour le casser, sinon l'animation se jouerait hors de l'écran.
    const whenVisible = () =>
      new Promise<void>((resolve) => {
        if (!('IntersectionObserver' in window)) return resolve();
        const observer = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              observer.disconnect();
              resolve();
            }
          },
          { threshold: 0.6 },
        );
        observer.observe(stage);
      });

    const start = async () => {
      if (!motion.matches) {
        hero.classList.add('is-open', 'has-paper');
        announceOpen();
        return;
      }
      busy = true;
      const images = [...hero.querySelectorAll('img')];
      await Promise.all(images.map((image) => image.decode().catch(() => undefined)));
      await whenVisible();
      await wait(250);
      await breakCookie();
      await wait(300);
      announceOpen();
      busy = false;
    };

    start();
  }
</script>

<style>
  .cookie-hero {
    --open-left: translate(-11%, 2%) rotate(-9deg);
    --open-right: translate(11%, 2%) rotate(8deg);
    position: relative;
  }

  .cookie-scene {
    position: relative;
    aspect-ratio: 620 / 560;
  }

  .cookie-shadow {
    position: absolute;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.3, 1);
    left: 15%;
    right: 15%;
    top: 74%;
    height: 9%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--h-ink) 45%, transparent), transparent);
  }

  .cookie-stage {
    position: absolute;
    left: 9%;
    top: 0;
    z-index: 2;
    width: 78%;
    aspect-ratio: 900 / 854;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    /* Les miettes se placent en pour cent de la largeur du cookie (cqw). */
    container-type: inline-size;
  }

  .cookie-stage:focus-visible {
    outline: 4px solid var(--hue-ink);
    outline-offset: -8px;
  }

  .cookie-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
  }

  /* État ouvert : c'est aussi l'affichage sans JavaScript. */
  .cookie-whole {
    opacity: 0;
  }

  .cookie-half {
    transform-origin: 50% 90%;
    transition:
      transform 0.8s cubic-bezier(0.2, 0.9, 0.25, 1.15),
      opacity 0s;
  }

  .cookie-left {
    transform: var(--open-left);
  }

  .cookie-right {
    transform: var(--open-right);
  }

  /* Une fois ouvert, les deux moitiés prennent plus de place sur la table. */
  .cookie-hero.is-open .cookie-shadow {
    transform: scaleX(1.12);
  }

  /* Le bras entre par la droite de l'écran et pointe vers le haut du cookie. */
  .arm {
    position: absolute;
    left: 64%;
    bottom: 58%;
    z-index: 3;
    width: 230%;
    transform: translate(1.6%, -2.7%);
    transform-origin: 100% 0;
    pointer-events: none;
  }

  .arm :global(img),
  .pigeon :global(img) {
    width: 100%;
    max-width: none;
  }

  .pigeon {
    position: absolute;
    left: -12%;
    bottom: 3%;
    z-index: 4;
    width: 34%;
    transform-origin: 55% 100%;
    pointer-events: none;
  }

  /* Le papier, comme ceux du jeu : blanc cassé, liserés rouges, ombre nette. Une fois le
     cookie ouvert, le ruban de la page (PaperRibbon) dessine ce papier sous le texte et le
     prolonge depuis son bout droit : papier et ruban ne forment qu'une seule bande. */
  /* Centré sans transform : le ruban mesure la place du papier sans ses transformations,
     même si l'animation de sortie n'est pas finie (onglet en arrière-plan). */
  .fortune {
    position: absolute;
    left: 22%;
    top: 83%;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(400px, 62%);
    min-height: 72px;
    padding: 14px 24px 12px;
    background:
      linear-gradient(var(--slip-rule), var(--slip-rule)) 10px 6px / calc(100% - 20px) 1.5px no-repeat,
      linear-gradient(var(--slip-rule), var(--slip-rule)) 10px calc(100% - 6px) / calc(100% - 20px) 1.5px no-repeat,
      var(--slip);
    box-shadow:
      2px 4px 0 var(--slip-shadow),
      4px 8px 0 var(--slip-shadow-soft);
    transition:
      transform 0.45s cubic-bezier(0.25, 1.35, 0.45, 1),
      opacity 0.12s linear;
  }

  .fortune.is-attached {
    background: none;
    box-shadow: none;
  }

  .fortune-text {
    margin: 0;
    color: var(--slip-ink);
    font-family: var(--font-paper);
    font-size: 17px;
    line-height: 1.25;
    text-align: center;
    transition: opacity 0.25s ease 0.15s;
  }

  /* Les miettes partent de la fissure, en haut du cookie. */
  .crumbs {
    position: absolute;
    left: 46%;
    top: 19cqw;
    z-index: 4;
  }

  .crumb {
    position: absolute;
    left: var(--x);
    top: var(--y);
    opacity: 0;
  }

  /* Morceaux cassés : des éclats anguleux, dorés dehors et plus clairs dedans. */
  .crumb-bit {
    display: block;
    width: calc(4cqw * var(--s));
    height: calc(3cqw * var(--s));
    margin: calc(-1.5cqw * var(--s)) 0 0 calc(-2cqw * var(--s));
    background: linear-gradient(160deg, #f0c27a 0 45%, #d8964b 46%);
  }

  .crumb-a {
    clip-path: polygon(8% 30%, 55% 0, 100% 38%, 80% 100%, 20% 88%);
  }

  .crumb-b {
    clip-path: polygon(0 55%, 35% 5%, 92% 18%, 70% 80%, 30% 100%);
    background: linear-gradient(200deg, #f5dcaa 0 50%, #e2ad66 51%);
  }

  .crumb-c {
    clip-path: polygon(18% 0, 100% 25%, 85% 70%, 40% 100%, 0 62%);
    background: linear-gradient(120deg, #c98840 0 40%, #eab872 41%);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Avec JavaScript, le cookie arrive entier puis se casse. */
    :global(.js) .cookie-hero:not(.is-open, .is-cracking) .cookie-whole {
      opacity: 1;
      transform-origin: 50% 92%;
      animation: cookie-in 0.38s linear;
    }

    :global(.js) .cookie-hero:not(.is-open, .is-cracking) .cookie-half {
      opacity: 0;
      transform: none;
      transition:
        opacity 0.2s ease,
        transform 0s linear 0.2s;
    }

    /* Juste avant de claquer, le cookie se fend : les deux moitiés s'écartent à peine. */
    .cookie-hero.is-cracking .cookie-half {
      opacity: 1;
      transition: none;
    }

    .cookie-hero.is-cracking .cookie-left {
      transform: translate(-0.8%, 0.6%) rotate(-1.2deg);
    }

    .cookie-hero.is-cracking .cookie-right {
      transform: translate(0.8%, 0.6%) rotate(1deg);
    }

    /* Puis les moitiés partent d'un coup, sautent un peu et retombent sur la table. */
    .cookie-hero.is-open .cookie-left {
      animation: left-open 0.7s linear;
    }

    .cookie-hero.is-open .cookie-right {
      animation: right-open 0.7s linear;
    }

    /* Avant la première cassure, le papier est encore dans le cookie et le pigeon n'est pas là. */
    :global(.js) .cookie-hero:not(.has-paper) .fortune {
      opacity: 0;
      transform: translateY(-150%) scale(0.15) rotate(-20deg);
      transition: none;
    }

    :global(.js) .cookie-hero:not(.has-paper) .pigeon {
      opacity: 0;
    }

    .cookie-hero.has-paper .pigeon {
      animation: pigeon-in 0.9s 0.25s cubic-bezier(0.3, 0.7, 0.4, 1) backwards;
    }

    .cookie-hero.is-changing .fortune-text {
      opacity: 0;
      transition: opacity 0.15s ease;
    }

    :global(.js) .cookie-hero.is-shaking:not(.is-open) .cookie-whole {
      transform-origin: 50% 92%;
      animation: cookie-press 0.24s ease-in forwards;
    }

    .arm {
      transition: transform 0.6s cubic-bezier(0.3, 0.9, 0.3, 1.1);
    }

    /* Même animation pendant la fissure : elle continue sans repartir de zéro. */
    .cookie-hero.is-shaking .arm,
    .cookie-hero.is-cracking .arm {
      animation: arm-tap 0.3s ease-in forwards;
    }

    .cookie-hero.is-open .arm {
      animation: arm-back 0.5s cubic-bezier(0.3, 0.9, 0.3, 1);
    }

    .cookie-stage:hover ~ .arm {
      transform: translate(2.7%, -4.4%);
    }

    .cookie-hero.is-open .crumb {
      animation: crumb-x 1.7s var(--delay) linear backwards;
    }

    .cookie-hero.is-open .crumb-bit {
      animation: crumb-y 1.7s var(--delay) linear backwards;
    }

    .cookie-stage:hover .cookie-whole {
      transform: rotate(-3deg) scale(1.02);
      transition: transform 0.25s ease;
    }
  }

  /* Un nouveau cookie tombe sur la table et s'aplatit un instant en arrivant. */
  @keyframes cookie-in {
    0% {
      opacity: 0;
      transform: translateY(-22%);
      animation-timing-function: cubic-bezier(0.5, 0, 1, 0.6);
    }
    20% {
      opacity: 1;
    }
    58% {
      transform: none;
      animation-timing-function: ease-out;
    }
    70% {
      transform: scale(1.04, 0.95);
      animation-timing-function: ease-in-out;
    }
    86% {
      transform: scale(0.99, 1.02);
      animation-timing-function: ease-in-out;
    }
    100% {
      transform: none;
    }
  }

  /* Le doigt appuie sur le haut du cookie, qui s'écrase un peu et penche. */
  @keyframes cookie-press {
    0%,
    55% {
      transform: none;
    }
    100% {
      transform: rotate(-1.5deg) scale(1.03, 0.95);
    }
  }

  @keyframes arm-tap {
    45% {
      transform: translate(3.8%, -6%);
    }
    80% {
      transform: translate(-1.4%, 2.2%);
    }
    100% {
      transform: translate(-2.2%, 3.4%);
    }
  }

  @keyframes arm-back {
    from {
      transform: translate(-2.2%, 3.4%);
    }
  }

  @keyframes left-open {
    0% {
      transform: translate(-0.8%, 0.6%) rotate(-1.2deg);
      animation-timing-function: cubic-bezier(0.15, 0.8, 0.4, 1);
    }
    32% {
      transform: translate(-12%, -3.5%) rotate(-11deg);
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.5);
    }
    62% {
      transform: translate(-11%, 2%) rotate(-8deg);
      animation-timing-function: ease-out;
    }
    78% {
      transform: translate(-11%, 1.2%) rotate(-9.6deg);
      animation-timing-function: ease-in-out;
    }
    100% {
      transform: var(--open-left);
    }
  }

  @keyframes right-open {
    0% {
      transform: translate(0.8%, 0.6%) rotate(1deg);
      animation-timing-function: cubic-bezier(0.15, 0.8, 0.4, 1);
    }
    30% {
      transform: translate(12.5%, -3%) rotate(10deg);
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.5);
    }
    60% {
      transform: translate(11%, 2%) rotate(7deg);
      animation-timing-function: ease-out;
    }
    76% {
      transform: translate(11%, 1.3%) rotate(8.6deg);
      animation-timing-function: ease-in-out;
    }
    100% {
      transform: var(--open-right);
    }
  }

  @keyframes pigeon-in {
    0% {
      opacity: 0;
      transform: translate(-70%, 0) rotate(0);
    }
    15% {
      opacity: 1;
    }
    25% {
      transform: translate(-50%, -14%) rotate(4deg);
    }
    50% {
      transform: translate(-32%, 0) rotate(0);
    }
    72% {
      transform: translate(-14%, -12%) rotate(4deg);
    }
    100% {
      transform: none;
    }
  }

  /* Les miettes avancent à vitesse presque constante, montent en ralentissant puis retombent
     en accélérant, rebondissent un peu sur la table, y restent un moment et disparaissent. */
  @keyframes crumb-x {
    0% {
      opacity: 1;
      transform: none;
      animation-timing-function: cubic-bezier(0.2, 0.5, 0.5, 1);
    }
    44% {
      transform: translateX(var(--dx));
      animation-timing-function: ease-out;
    }
    56% {
      transform: translateX(calc(var(--dx) * 1.1));
    }
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(calc(var(--dx) * 1.1));
    }
  }

  @keyframes crumb-y {
    0% {
      transform: none;
      animation-timing-function: cubic-bezier(0.3, 0.7, 0.6, 1);
    }
    16% {
      transform: translateY(var(--up)) rotate(calc(var(--r) * 0.4));
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.6);
    }
    44% {
      transform: translateY(var(--land)) rotate(var(--r));
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.5, 1);
    }
    50% {
      transform: translateY(calc(var(--land) - 2cqw)) rotate(calc(var(--r) * 1.1));
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.5);
    }
    56%,
    100% {
      transform: translateY(var(--land)) rotate(calc(var(--r) * 1.15));
    }
  }

  /* Sur téléphone, le papier est plus large et le pigeon reste à côté du cookie. Une place est
     gardée à droite pour que le ruban tourne vers le bord. */
  @media (max-width: 560px) {
    .cookie-scene {
      aspect-ratio: 620 / 640;
    }

    .cookie-stage {
      left: 14%;
    }

    .cookie-shadow {
      top: 63%;
    }

    .arm {
      bottom: 63%;
    }

    .pigeon {
      left: -3%;
      bottom: 24%;
      width: 33%;
    }

    .fortune {
      left: 3%;
      top: 79%;
      width: 80%;
      min-height: 62px;
      padding-inline: 14px;
    }

    .fortune-text {
      font-size: 15px;
    }
  }
</style>
