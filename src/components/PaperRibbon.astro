---
// Le papier de fortune qui sort du cookie et descend le long de la page.
// SVG décoratif placé derrière le contenu ; il se déroule avec le défilement.
// Le papier du cookie ([data-ribbon-start]) en est le début : une fois le cookie ouvert, c'est
// ce SVG qui dessine le papier sous son texte (classe is-attached sur le papier), puis le
// prolonge depuis son bout droit, à la même hauteur et avec les mêmes liserés rouges. Le ruban
// s'affine ensuite en douceur jusqu'à la largeur de la marge, longe chaque section
// [data-ribbon-side="left|right"]. Jusque-là il est posé à plat ; à la fin, il se plie en accordéon
// et se déplie vers nous, en perspective : le papier de [data-ribbon-end] en est le dernier
// panneau, dessiné lui aussi par ce SVG (classe is-attached).
---

<svg class="ribbon" aria-hidden="true" focusable="false">
  <defs>
    <mask id="ribbon-mask" maskUnits="userSpaceOnUse">
      <path class="ribbon-reveal" fill="none" stroke="#fff" stroke-linecap="butt" stroke-linejoin="round"></path>
    </mask>
    <!-- Ombres des plis : face éclairée, face dans l'ombre, dernier panneau près de sa pliure. -->
    <linearGradient id="fold-lit"><stop offset="0" stop-color="#e9dfcb"></stop><stop offset="1" stop-color="#fffdf6"></stop></linearGradient>
    <linearGradient id="fold-dark"><stop offset="0" stop-color="#dccfb5"></stop><stop offset="1" stop-color="#c3b392"></stop></linearGradient>
    <linearGradient id="fold-end"><stop offset="0" stop-color="#efe6d5"></stop><stop offset="0.1" stop-color="#fffdf6"></stop></linearGradient>
  </defs>
  <path class="ribbon-center" fill="none" stroke="none"></path>
  <g class="ribbon-band">
    <path class="ribbon-shadow ribbon-shadow-soft" transform="translate(4 8)"></path>
    <path class="ribbon-shadow" transform="translate(2 4)"></path>
    <path class="ribbon-paper"></path>
    <path class="ribbon-rules" fill="none"></path>
  </g>
  <g class="ribbon-folds">
    <path class="ribbon-shadow ribbon-shadow-soft"></path>
    <path class="ribbon-shadow"></path>
    <g class="ribbon-faces"></g>
    <path class="ribbon-rules" fill="none" stroke-width="1.5"></path>
  </g>
  <g class="ribbon-tip">
    <rect class="ribbon-roll"></rect>
    <path class="ribbon-roll-line"></path>
  </g>
</svg>

<script>
  type Point = [number, number];

  const svg = document.querySelector<SVGSVGElement>('svg.ribbon');
  const root = svg?.parentElement;

  if (svg && root) {
    const center = svg.querySelector<SVGPathElement>('.ribbon-center')!;
    const reveal = svg.querySelector<SVGPathElement>('.ribbon-reveal')!;
    const paper = svg.querySelector<SVGPathElement>('.ribbon-paper')!;
    const shadows = svg.querySelectorAll<SVGPathElement>('.ribbon-band .ribbon-shadow');
    const rules = svg.querySelector<SVGPathElement>('.ribbon-band .ribbon-rules')!;
    const folds = svg.querySelector<SVGGElement>('.ribbon-folds')!;
    const foldShadows = folds.querySelectorAll<SVGPathElement>('.ribbon-shadow');
    const foldFaces = folds.querySelector<SVGGElement>('.ribbon-faces')!;
    const foldRules = folds.querySelector<SVGPathElement>('.ribbon-rules')!;
    const gradients = svg.querySelectorAll<SVGLinearGradientElement>('linearGradient');
    const mask = svg.querySelector<SVGMaskElement>('mask')!;
    const band = svg.querySelector<SVGGElement>('.ribbon-band')!;
    const tip = svg.querySelector<SVGGElement>('.ribbon-tip')!;
    const roll = svg.querySelector<SVGRectElement>('.ribbon-roll')!;
    const rollLine = svg.querySelector<SVGPathElement>('.ribbon-roll-line')!;
    const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
    const STEP = 6;
    // Comme sur les papiers du jeu : liserés de 1,5 px, à 6 px du bord, 10 px en retrait au bout.
    const RULE_MARGIN = 10;

    let total = 0;
    let drawn = 0;
    let target = 0;
    let active = false;
    let frame = 0;
    let builds = 0;
    // Largeur le long de la page ; largeur et longueur du papier du cookie (toujours visible
    // une fois le cookie ouvert).
    let ribbonWidth = 12;
    let startWidth = 12;
    let lead = 0;
    // Le ruban s'affine de chaque côté séparément : côté intérieur du premier virage (à droite
    // dans le sens du ruban) et côté extérieur, chacun entre deux longueurs.
    let innerFrom = 0;
    let innerTo = 0;
    let outerFrom = 0;
    let outerTo = 0;
    // Échantillons du ruban : longueur parcourue, hauteur atteinte, points des deux bords.
    let lengths: number[] = [];
    let samples: number[] = [];
    let edgesA: Point[] = [];
    let edgesB: Point[] = [];
    let start: HTMLElement | null = null;
    const end = root.querySelector<HTMLElement>('[data-ribbon-end]');
    // L'accordéon de la fin. Chaque pliure a une place le long du papier et une demi-largeur : plus
    // elle est large, plus elle est près de nous.
    interface FoldLine {
      at: number;
      half: number;
      shift: number;
    }
    interface Accordion {
      vertical: boolean;
      middle: number;
      size: number;
      length: number;
      lines: FoldLine[];
    }
    let accordion: Accordion | null = null;
    // Place et avancée vers nous de chaque pliure (creux, bosse, creux…, dernière pliure). Le papier
    // est vu un peu de biais : les bosses, plus près, sont aussi décalées d'un côté.
    const FOLD_AT = [0, 0.13, 0.24, 0.39, 0.51, 0.68, 0.8, 1];
    const FOLD_NEAR = [0, 0.17, 0.16, 0.36, 0.34, 0.6, 0.58, 1];
    const FOLD_SHIFT = [0, 0.07, -0.06, 0.09, -0.08, 0.11, -0.1, 0];
    const FOLD_TIME = 1500;
    let opened = 0;
    let openedFrom = 0;

    const f = (n: number) => n.toFixed(1);

    const box = (element: Element) => {
      const rect = element.getBoundingClientRect();
      const origin = root.getBoundingClientRect();
      return { x: rect.left - origin.left, y: rect.top - origin.top, w: rect.width, h: rect.height };
    };

    // Place d'un élément dans la mise en page, sans ses transformations CSS.
    const layoutBox = (element: HTMLElement) => {
      const parent = element.offsetParent;
      if (!parent) return box(element);
      const p = box(parent);
      return {
        x: p.x + parent.clientLeft + element.offsetLeft,
        y: p.y + parent.clientTop + element.offsetTop,
        w: element.offsetWidth,
        h: element.offsetHeight,
      };
    };

    const ease = (value: number, from: number, to: number) => {
      if (value <= from) return 0;
      if (value >= to) return 1;
      const t = (value - from) / (to - from);
      return t * t * (3 - 2 * t);
    };

    // Demi-largeurs [intérieur, extérieur] à une longueur donnée. Dans un virage, le bord
    // intérieur ne doit s'affiner qu'une fois le virage passé : s'il s'affinait avant, le bas
    // du papier remonterait juste avant de tourner et ferait une bosse.
    const sides = (length: number): Point => {
      const half = startWidth / 2;
      const change = (startWidth - ribbonWidth) / 2;
      return [half - change * ease(length, innerFrom, innerTo), half - change * ease(length, outerFrom, outerTo)];
    };

    // Distance entre le bord du papier et le milieu d'un liseré : 6,75 px sur le papier du
    // cookie (liseré de 1,5 px à 6 px du bord), moins sur un ruban étroit.
    const ruleInset = (width: number) => Math.min(6.75, Math.max(2.5, width * 0.116));

    // Tracé de la ligne centrale, en coordonnées de la zone parente. Le ruban descend dans la marge
    // de chaque section ; il ne change de côté que dans l'espace vide entre deux sections.
    const route = (): string | null => {
      start = root.querySelector<HTMLElement>('[data-ribbon-start]');
      if (!start) return null;
      const width = root.clientWidth;
      const container = root.querySelector('.container');
      const gutter = container ? box(container).x : 16;
      const wide = gutter >= 70;
      ribbonWidth = wide ? Math.min(56, gutter - 20) : Math.max(10, Math.min(40, gutter - 8));
      const half = ribbonWidth / 2;
      const leftX = wide ? Math.min(gutter / 2, 110) : half + 3;
      const rightX = width - leftX;
      const turnRadius = wide ? Math.min(120, Math.max(64, gutter - leftX)) : Math.max(28, ribbonWidth * 1.6);
      const K = 0.5523; // quart de cercle en courbe de Bézier

      // Départ : tout le papier du cookie, à mi-hauteur, puis un quart de cercle vers la marge.
      // Sa place est lue sans ses transformations : elle est juste même pendant qu'il sort.
      const s = layoutBox(start);
      let y = s.y + s.h / 2;
      startWidth = s.h;
      const room = rightX - s.x - s.w;
      const radius = Math.max(24, Math.min(wide ? 160 : 95, room - Math.max(8, Math.min(20, room * 0.2))));
      const run = Math.max(8, room - radius);
      let x = s.x + s.w + run + radius;
      let d = `M${f(s.x)} ${f(y)} L${f(x - radius)} ${f(y)}`;
      d += ` C${f(x - radius * (1 - K))} ${f(y)} ${f(x)} ${f(y + radius * (1 - K))} ${f(x)} ${f(y + radius)}`;
      y += radius;

      // Le bord extérieur s'affine pendant le virage (le papier reste dans l'écran), le bord
      // intérieur juste après, quand le ruban descend ; dès le début si le virage est trop serré.
      const gap = Math.abs(startWidth - ribbonWidth);
      const turnStart = s.w + run;
      const turnEnd = turnStart + (Math.PI / 2) * radius;
      lead = s.w + Math.min(run, 20) * 0.5;
      outerFrom = turnStart;
      outerTo = turnEnd;
      innerFrom = radius > startWidth / 2 + 8 ? turnEnd : turnStart;
      innerTo = innerFrom + Math.max(60, gap * 2.2);

      // Descente dans la marge, avec une légère ondulation quand la marge est large.
      const wave = wide ? Math.max(0, Math.min(10, leftX - half - 4)) : 0;
      const down = (to: number) => {
        const from = y;
        const base = x;
        const count = Math.max(1, Math.round((to - from) / 340));
        for (let i = 1; i <= count; i += 1) {
          const nextX = base + (i < count ? (i % 2 ? wave : -wave) : 0);
          const nextY = from + ((to - from) * i) / count;
          const mid = (y + nextY) / 2;
          d += ` C${f(x)} ${f(mid)} ${f(nextX)} ${f(mid)} ${f(nextX)} ${f(nextY)}`;
          x = nextX;
          y = nextY;
        }
      };

      // Traversée entre deux contenus (hauteurs top et bottom) : virage, passage, virage.
      const cross = (toX: number, top: number, bottom: number) => {
        const direction = toX > x ? 1 : -1;
        const r = Math.min(turnRadius, Math.abs(toX - x) / 2);
        const middle = (top + bottom) / 2;
        // Légère pente, seulement si la place le permet.
        const slope = Math.max(0, Math.min(24, (bottom - top) / 2 - half - 24));
        down(Math.max(y + 1, middle - slope - r));
        const y1 = y + r;
        const y2 = Math.max(y1, middle + slope);
        const x1 = x + direction * r;
        const x2 = toX - direction * r;
        const midX = (x1 + x2) / 2;
        d += ` C${f(x)} ${f(y + r * K)} ${f(x1 - direction * r * K)} ${f(y1)} ${f(x1)} ${f(y1)}`;
        d += ` C${f(midX)} ${f(y1)} ${f(midX)} ${f(y2)} ${f(x2)} ${f(y2)}`;
        d += ` C${f(x2 + direction * r * K)} ${f(y2)} ${f(toX)} ${f(y2 + r * (1 - K))} ${f(toX)} ${f(y2 + r)}`;
        x = toX;
        y = y2 + r;
      };

      const content = (section: Element) => box(section.querySelector('.container') ?? section);
      const sections = [...root.querySelectorAll<HTMLElement>('[data-ribbon-side]')];
      let side = 'right';
      sections.forEach((section, index) => {
        const next = section.dataset.ribbonSide ?? side;
        if (index === 0 || next === side) return;
        const above = content(sections[index - 1]);
        cross(next === 'left' ? leftX : rightX, above.y + above.h, content(section).y);
        side = next;
      });

      // Fin : le ruban arrive par la gauche et se plie en accordéon, vers la droite ; sur téléphone,
      // il rejoint le milieu de la section et se plie vers le bas.
      accordion = null;
      if (end) {
        const e = layoutBox(end);
        const last = sections[sections.length - 1];
        const vertical = e.x - leftX < 200;
        const middle = vertical ? e.x + e.w / 2 : e.y + e.h / 2;
        const size = vertical ? e.w : e.h;
        const hinge = vertical ? e.y : e.x;
        if (side !== 'left' && last) {
          const above = content(last);
          cross(leftX, above.y + above.h, e.y);
        }
        let from: number;
        if (vertical) {
          from = e.y - 158;
          cross(middle, box(end.closest('section') ?? end).y, from - 6);
          d += ` L${f(x)} ${f(from)}`;
        } else {
          const bend = Math.max(half + 10, Math.min(96, (hinge - x) * 0.34));
          down(Math.max(y + 1, middle - bend));
          d += ` C${f(x)} ${f(y + (middle - y) * K)} ${f(x + bend * (1 - K))} ${f(middle)} ${f(x + bend)} ${f(middle)}`;
          from = Math.max(x + bend + 12, hinge - 260);
          d += ` L${f(from)} ${f(middle)}`;
        }
        accordion = {
          vertical,
          middle,
          size,
          length: vertical ? e.h : e.w,
          lines: FOLD_AT.map((at, i) => ({
            at: from + (hinge - from) * at,
            half: (ribbonWidth + (size - ribbonWidth) * FOLD_NEAR[i]) / 2,
            // Moins de biais sur téléphone, où les pliures sont plus larges.
            shift: size * FOLD_SHIFT[i] * (vertical ? 0.6 : 1),
          })),
        };
      }
      return d;
    };

    // Contour du ruban (largeur variable) et ses deux liserés, calculés de part et d'autre
    // de la ligne centrale. Retient aussi, pour le défilement, la hauteur atteinte à chaque pas.
    const shape = () => {
      total = center.getTotalLength();
      lengths = [];
      const count = Math.max(2, Math.ceil(total / STEP));
      for (let i = 0; i <= count; i += 1) lengths.push((total * i) / count);

      const points = lengths.map((along): Point => {
        const p = center.getPointAtLength(along);
        return [p.x, p.y];
      });
      const tangent = (list: Point[], i: number): Point => {
        const a = list[Math.max(0, i - 1)];
        const b = list[Math.min(list.length - 1, i + 1)];
        const length = Math.hypot(b[0] - a[0], b[1] - a[1]) || 1;
        return [(b[0] - a[0]) / length, (b[1] - a[1]) / length];
      };

      // Les deux bords : A du côté intérieur du premier virage, B de l'autre.
      samples = [];
      edgesA = [];
      edgesB = [];
      let maxY = -Infinity;
      points.forEach(([x, y], i) => {
        const along = lengths[i];
        const [ux, uy] = tangent(points, i);
        const [inner, outer] = sides(along);
        edgesB.push([x + uy * outer, y - ux * outer]);
        edgesA.push([x - uy * inner, y + ux * inner]);
        maxY = Math.max(maxY, y);
        samples.push(maxY);
      });

      // Les liserés commencent à 10 px du bout du papier, comme dans le jeu (le bout est droit), et
      // se poursuivent sur l'accordéon.
      const ruleA: string[] = [];
      const ruleB: string[] = [];
      const last = lengths.length - 1;
      const addRule = (i: number, shift: number) => {
        const width = Math.hypot(edgesA[i][0] - edgesB[i][0], edgesA[i][1] - edgesB[i][1]);
        const inset = ruleInset(width);
        const [ax, ay] = tangent(edgesA, i);
        const [bx, by] = tangent(edgesB, i);
        ruleA.push(`${f(edgesA[i][0] + ay * inset + ax * shift)} ${f(edgesA[i][1] - ax * inset + ay * shift)}`);
        ruleB.push(`${f(edgesB[i][0] - by * inset + bx * shift)} ${f(edgesB[i][1] + bx * inset + by * shift)}`);
      };
      addRule(0, RULE_MARGIN);
      lengths.forEach((along, i) => {
        if (along > RULE_MARGIN && i < last) addRule(i, 0);
      });
      addRule(last, accordion ? 0 : -RULE_MARGIN);

      const list = (edgePoints: Point[]) => edgePoints.map(([x, y]) => `${f(x)} ${f(y)}`);
      const outline = `M${list(edgesA).join('L')}L${list(edgesB).reverse().join('L')}Z`;
      paper.setAttribute('d', outline);
      shadows.forEach((path) => path.setAttribute('d', outline));
      rules.setAttribute('d', `M${ruleA.join('L')}M${ruleB.join('L')}`);
      rules.setAttribute('stroke-width', ribbonWidth >= 20 ? '1.5' : '1.2');
    };

    // Dernier rang d'une liste croissante dont la valeur ne dépasse pas la limite.
    const rank = (list: number[], limit: number) => {
      let lo = 0;
      let hi = list.length - 1;
      while (lo < hi) {
        const mid = (lo + hi + 1) >> 1;
        if (list[mid] <= limit) lo = mid;
        else hi = mid - 1;
      }
      return lo;
    };

    // Longueur de ruban à dérouler pour atteindre une hauteur donnée.
    const lengthAtY = (y: number) => lengths[rank(samples, y)] ?? 0;

    // Les deux bords du ruban à une longueur donnée, entre deux échantillons.
    const frontAt = (length: number): [Point, Point] => {
      const k = Math.min(lengths.length - 2, rank(lengths, length));
      const t = (length - lengths[k]) / (lengths[k + 1] - lengths[k] || 1);
      const mix = (a: Point, b: Point): Point => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
      return [mix(edgesA[k], edgesA[k + 1]), mix(edgesB[k], edgesB[k + 1])];
    };

    // L'accordéon, plus ou moins déplié (de 0 à 1) : les plis s'écartent et avancent vers nous, puis le
    // dernier panneau pivote autour de sa pliure jusqu'à nous faire face, avec son texte.
    const renderFolds = () => {
      const shown = Boolean(active && accordion && opened > 0);
      folds.style.display = shown ? '' : 'none';
      if (!end || !accordion) return;
      if (!shown) {
        end.style.opacity = active ? '0' : '';
        end.style.transform = '';
        return;
      }
      const { vertical, middle, size, length } = accordion;
      const rest = 1 - Math.min(1, opened / 0.62);
      const spread = 1 - rest * rest * rest;
      const first = accordion.lines[0];
      const lines = accordion.lines.map(({ at, half, shift }) => ({
        at: first.at + (at - first.at) * (0.1 + 0.9 * spread),
        half: first.half + (half - first.half) * spread,
        shift: shift * spread,
      }));
      const hinge = lines[lines.length - 1];
      const scale = (hinge.half * 2) / size;
      // Pivot du dernier panneau ; il dépasse un peu avant de se poser.
      const turn = Math.max(0, Math.min(1, (opened - 0.2) / 0.8)) - 1;
      const angle = -(2.1 * turn + 1.1) * turn * turn * 1.45 * (turn < 0 ? 1 : 0);
      const depth = Math.max(900, length * 2.4);
      const panel = length * scale;
      const near = depth / (depth - panel * Math.sin(angle));
      const far = { at: hinge.at + panel * Math.cos(angle) * near, half: hinge.half * near, shift: 0 };

      const all = [...lines, far];
      const point = (at: number, offset: number): Point => (vertical ? [middle + offset, at] : [at, middle + offset]);
      const corner = (line: FoldLine, sign: number, inset = 0) => point(line.at, line.shift + sign * (line.half - inset));
      const text = ([x, y]: Point) => `${f(x)} ${f(y)}`;
      while (foldFaces.childElementCount < lines.length) foldFaces.append(document.createElementNS(svg.namespaceURI, 'path'));
      [...foldFaces.children].forEach((face, i) => {
        const [a, b] = [all[i], all[i + 1]];
        const kind = i === lines.length - 1 ? 'end' : i % 2 ? 'dark' : 'lit';
        face.setAttribute('fill', `url(#fold-${kind})`);
        face.setAttribute('d', b ? `M${[corner(a, -1), corner(b, -1), corner(b, 1), corner(a, 1)].map(text).join('L')}Z` : '');
      });

      // Ombre portée : elle s'éloigne du papier quand il avance vers nous.
      foldShadows.forEach((path, layer) => {
        const cast = (line: FoldLine, sign: number): Point => {
          const lift = Math.min(1, (line.half * 2 - first.half * 2) / Math.max(1, size - first.half * 2));
          const [x, y] = corner(line, sign);
          const amount = layer === 0 ? 2 : 1;
          return [x + (2 + 6 * lift) * amount, y + (4 + 9 * lift) * amount];
        };
        path.setAttribute('d', `M${[...all.map((line) => cast(line, -1)), ...[...all].reverse().map((line) => cast(line, 1))].map(text).join('L')}Z`);
      });

      const ruleEnd = { ...far, at: far.at - RULE_MARGIN };
      const inset = (half: number) => ruleInset(first.half * 2) + (8 - ruleInset(first.half * 2)) * Math.min(1, (half - first.half) / Math.max(1, size / 2 - first.half));
      const rule = (sign: number) => [...lines, ruleEnd].map((line) => text(corner(line, sign, inset(line.half)))).join('L');
      foldRules.setAttribute('d', `M${rule(-1)}M${rule(1)}`);

      const moved = hinge.at - accordion.lines[accordion.lines.length - 1].at;
      end.style.opacity = opened > 0.25 ? '1' : '0';
      end.style.transformOrigin = vertical ? '50% 0' : '0 50%';
      end.style.transform =
        opened < 1
          ? `${vertical ? 'translateY' : 'translateX'}(${f(moved)}px) perspective(${f(depth)}px) ${vertical ? 'rotateX' : 'rotateY'}(${((vertical ? 1 : -1) * angle).toFixed(4)}rad) scale(${scale.toFixed(4)})`
          : '';
    };

    const unfold = (now: number) => {
      openedFrom ||= now;
      opened = Math.min(1, Math.max(0.001, (now - openedFrom) / FOLD_TIME));
      renderFolds();
      if (opened < 1) requestAnimationFrame(unfold);
    };
    let unfolding = false;

    const scrollTarget = () => {
      if (!active) return 0;
      const y = window.innerHeight * 0.82 - root.getBoundingClientRect().top;
      return Math.max(lead, lengthAtY(y));
    };

    // Partie visible : le papier du cookie dès qu'il est sorti, puis ce qui est déroulé.
    // Le rouleau de papier se trouve au bout de la partie déroulée.
    const render = () => {
      const visible = active ? Math.max(drawn, lead) : 0;
      reveal.setAttribute('stroke-dashoffset', String(total - visible));
      // Tout le ruban est déroulé : l'accordéon se déplie.
      if (active && !unfolding && total && visible > total - 1) {
        unfolding = true;
        if (motion.matches) requestAnimationFrame(unfold);
        else opened = 1;
      }
      if (!unfolding || opened === 1) renderFolds();
      // Entièrement déroulé : plus de masque (Chrome pouvait en garder une version périmée, qui
      // rognait le ruban après un changement de mise en page).
      const masked = visible < total - 0.5;
      if (masked) band.setAttribute('mask', `url(#${mask.id})`);
      else band.removeAttribute('mask');
      if (active && drawn > lead + 2 && drawn < total - 2 && lengths.length > 1) {
        const [p, q] = frontAt(drawn);
        const angle = (Math.atan2(p[1] - q[1], p[0] - q[0]) * 180) / Math.PI;
        const width = Math.hypot(p[0] - q[0], p[1] - q[1]) + 4;
        const thickness = Math.min(18, Math.max(7, width * 0.34));
        roll.setAttribute('x', f(-width / 2));
        roll.setAttribute('y', f(-thickness / 2));
        roll.setAttribute('width', f(width));
        roll.setAttribute('height', f(thickness));
        roll.setAttribute('rx', f(thickness / 2));
        rollLine.setAttribute('d', `M${f(-width / 2 + thickness / 2)} 0H${f(width / 2 - thickness / 2)}`);
        tip.setAttribute('transform', `translate(${f((p[0] + q[0]) / 2)} ${f((p[1] + q[1]) / 2)}) rotate(${f(angle)})`);
        tip.style.opacity = '1';
      } else {
        tip.style.opacity = '0';
      }
    };

    const tick = () => {
      frame = 0;
      const gap = target - drawn;
      if (Math.abs(gap) < 0.8) {
        drawn = target;
        render();
        return;
      }
      drawn += gap * 0.085;
      render();
      frame = requestAnimationFrame(tick);
    };

    const update = () => {
      if (!motion.matches) return;
      target = Math.max(target, scrollTarget());
      if (!frame && target !== drawn) frame = requestAnimationFrame(tick);
    };

    const build = () => {
      // Un nouvel identifiant à chaque tracé : le navigateur ne peut pas réutiliser l'ancien masque.
      builds += 1;
      mask.id = `ribbon-mask-${builds}`;
      const d = route();
      if (!d) {
        svg.classList.remove('is-ready');
        start?.classList.remove('is-attached');
        if (end) {
          end.classList.remove('is-attached');
          end.style.opacity = end.style.transform = '';
        }
        return;
      }
      const progress = total ? drawn / total : 0;
      const width = root.clientWidth;
      const height = root.offsetHeight;
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.setAttribute('width', String(width));
      svg.setAttribute('height', String(height));
      // La hauteur CSS vaut 0 tant que le tracé n'est pas calculé.
      svg.style.height = `${height}px`;
      for (const [name, value] of [['x', 0], ['y', 0], ['width', width], ['height', height]] as const) {
        mask.setAttribute(name, String(value));
      }

      center.setAttribute('d', d);
      reveal.setAttribute('d', d);
      shape();
      reveal.setAttribute('stroke-width', String(Math.max(startWidth, ribbonWidth) + 24));
      reveal.setAttribute('stroke-dasharray', `${total} ${total}`);

      if (motion.matches) {
        drawn = Math.max(lead, progress * total);
        target = Math.max(drawn, scrollTarget());
      } else {
        drawn = target = total;
      }
      svg.classList.add('is-ready');
      // Les papiers des deux bouts ne gardent que leur texte : le SVG dessine le papier dessous.
      start?.classList.toggle('is-attached', active);
      end?.classList.toggle('is-attached', active);
      gradients.forEach((gradient) => {
        gradient.setAttribute('x2', accordion?.vertical ? '0' : '1');
        gradient.setAttribute('y2', accordion?.vertical ? '1' : '0');
      });
      render();
      if (unfolding) renderFolds();
      update();
    };

    let timer = 0;
    const scheduleBuild = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(build, 120);
    };

    // Le ruban n'apparaît qu'une fois le cookie cassé et son papier sorti ; son point de
    // départ est recalculé à chaque ouverture, quand le papier est à sa place.
    const activate = () => {
      if (active) return;
      active = true;
      build();
    };

    const hero = root.querySelector<HTMLElement>('.cookie-hero');
    if (!hero || hero.dataset.opened === 'true' || !motion.matches) {
      active = true;
    } else {
      document.addEventListener('cookie:open', activate, { once: true });
    }
    document.addEventListener('cookie:open', scheduleBuild);

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', scheduleBuild);
    new ResizeObserver(scheduleBuild).observe(root);
    document.fonts?.ready.then(scheduleBuild);
    window.addEventListener('load', scheduleBuild);
    // Une section peut changer de hauteur sans que la zone entière change de taille.
    const sections = new ResizeObserver(scheduleBuild);
    root.querySelectorAll('[data-ribbon-start], [data-ribbon-side], [data-ribbon-end]').forEach((section) => sections.observe(section));
    build();
  }
</script>

<style>
  .ribbon {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    width: 100%;
    height: 0;
    overflow: visible;
    pointer-events: none;
    visibility: hidden;
  }

  .ribbon.is-ready {
    visibility: visible;
  }

  /* Le tracé (d) est mesuré juste après son changement : il ne doit jamais être animé, même par la
     règle générale des animations réduites. */
  .ribbon path {
    transition: none !important;
  }

  .ribbon-shadow {
    fill: var(--slip-shadow);
  }

  .ribbon-shadow-soft {
    fill: var(--slip-shadow-soft);
  }

  .ribbon-paper {
    fill: var(--slip);
  }

  .ribbon-rules {
    stroke: var(--slip-rule);
    stroke-linejoin: round;
  }

  .ribbon-tip {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ribbon-roll {
    fill: var(--slip);
    stroke: #d8cfbf;
    stroke-width: 1.2;
  }

  .ribbon-roll-line {
    fill: none;
    stroke: #d8cfbf;
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  @media print {
    .ribbon {
      display: none;
    }
  }
</style>
