---
// En-tête des pages intérieures : un aplat de la couleur de la page, un grand titre, un objet du
// jeu et un papier de fortune choisi selon le sujet. Les phrases viennent du jeu Fortune Cookie,
// sauf celle de la page de confidentialité, écrite pour elle.
import Objet from './Objet.astro';
import { fr } from '../lib/format';

interface Props {
  title: string;
  lead?: string;
  fortune?: string;
  objet?: string;
  /** L'aplat occupe toute la hauteur de l'écran (pages sans autre contenu). */
  full?: boolean;
}

const { title, lead, fortune, objet, full = false } = Astro.props;
---

<header class:list={['page-header', 'on-hue', { full }]}>
  <div class="container grid">
    <div class="text">
      <slot name="before" />
      <h1 class:list={[{ long: title.length > 24 }]}>{fr(title)}</h1>
      {lead && <p class="lead">{fr(lead)}</p>}
      <slot />
    </div>
    {
      (objet || Astro.slots.has('scene')) && (
        <div class:list={['scene', objet && `scene-${objet}`]} aria-hidden="true">
          {objet && <Objet name={objet} class="art" sizes="(min-width: 900px) 400px, 260px" eager />}
          <slot name="scene" />
          {fortune && <p class="paper slip">{fr(fortune)}</p>}
        </div>
      )
    }
  </div>
</header>

<style>
  .page-header {
    position: relative;
    z-index: 2;
    background: var(--hue);
    color: var(--hue-ink);
  }

  .grid {
    display: grid;
    gap: 2rem;
    padding-block: clamp(1.5rem, 4vw, 3.5rem) 2.5rem;
  }

  .text > :global(:last-child) {
    margin-bottom: 0;
  }

  h1 {
    margin-bottom: 0.35em;
    font-size: clamp(2.5rem, 12.4vw, 6rem);
  }

  h1.long {
    font-size: clamp(2.1rem, 9vw, 4.5rem);
  }

  .scene {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 190px;
    padding-bottom: 3.25rem;
  }

  .scene :global(.art) {
    width: auto;
    max-width: 72%;
    max-height: 220px;
  }

  .scene-baleine {
    padding-bottom: 5rem;
  }

  .scene-baleine :global(.art) {
    max-width: 100%;
    margin-right: -14%;
    max-height: none;
  }

  .paper {
    position: absolute;
    right: 0;
    bottom: -0.75rem;
    width: min(19rem, 82%);
    margin: 0;
    padding: 18px 22px 15px;
    font-size: 1.05rem;
    line-height: 1.3;
    text-align: center;
    transform: rotate(-3deg);
  }

  .full {
    display: grid;
    min-height: calc(100svh - var(--header-height) - 6rem);
  }

  .full .grid {
    align-content: center;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) min(400px, 33vw);
      align-items: center;
      min-height: 400px;
      padding-block: 2rem 2.5rem;
    }

    h1 {
      font-size: min(7.6vw, 6.75rem);
    }

    h1.long {
      font-size: min(5.4vw, 4.75rem);
    }

    /* L'objet déborde un peu sous l'aplat. */
    .scene {
      align-self: end;
      min-height: 320px;
      padding-bottom: 0;
      margin-bottom: -5.5rem;
    }

    .scene :global(.art) {
      max-width: 100%;
      max-height: 350px;
    }

    .paper {
      right: -1.25rem;
      bottom: 0.25rem;
    }

    /* Pour laisser voir les pattes du pigeon et la tête de la baleine. */
    .scene-baleine {
      padding-bottom: 0;
    }

    .scene-pigeon .paper {
      bottom: -3.5rem;
    }

    .scene-baleine .paper {
      bottom: -3rem;
    }

    .scene-baleine :global(.art) {
      flex: none;
      width: 128%;
      max-width: none;
      margin-right: -10%;
    }

    .full .scene {
      align-self: center;
      margin-bottom: 0;
    }

    .full .scene :global(.art) {
      max-height: 440px;
    }
  }
</style>
