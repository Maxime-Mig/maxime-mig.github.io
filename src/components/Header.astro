---
// Menu de la couleur de la page. Sur téléphone et petite tablette, les liens sont derrière un bouton.
import { navLinks, profile } from '../data/profile';
import CookieMark from './CookieMark.astro';
import Icon from './Icon.astro';
import { icon } from '../lib/icons';

const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---

<header class="site-header">
  <nav class="nav" aria-label="Menu principal">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}><CookieMark size={36} /><span>Maxime Miguet</span></a>
    <button class="bar-button menu-toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <Icon name="menu" class="when-closed" />
      <Icon name="close" class="when-open" />
      <span class="visually-hidden">Menu</span>
    </button>
    <ul class="nav-links" id="menu">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={current(link.href)}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={profile.cvPdf} download={profile.cvFileName}>CV<span class="visually-hidden"> en PDF</span></a>
      </li>
    </ul>
    <button class="bar-button theme-toggle" type="button" data-theme-toggle>
      <Icon name="dark_mode" data-light={icon('light_mode').char} data-dark={icon('dark_mode').char} />
      <span class="visually-hidden">Passer au thème <span data-theme-name>sombre</span></span>
    </button>
  </nav>
</header>

<script>
  // Thème clair ou sombre. Par défaut, celui du navigateur (aucun attribut data-theme). Le choix
  // est retenu dans le navigateur ; revenir au thème du navigateur efface ce choix, et le site
  // suit de nouveau ses changements.
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeName = document.querySelector<HTMLElement>('[data-theme-name]');
  const themeIcon = themeButton?.querySelector<HTMLElement>('.icon');

  if (themeButton && themeName) {
    const root = document.documentElement;
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
    const metas = [...document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')];
    type Theme = 'light' | 'dark';
    const color = (theme: Theme) => metas.find((meta) => meta.media.includes(theme))?.dataset.color ?? '';

    const systemTheme = (): Theme => (systemDark.matches ? 'dark' : 'light');
    const currentTheme = (): Theme => (root.dataset.theme === 'dark' || root.dataset.theme === 'light' ? root.dataset.theme : systemTheme());

    // Le bouton annonce le thème qu'il va mettre.
    const sync = () => {
      const dark = currentTheme() === 'dark';
      themeName.textContent = dark ? 'clair' : 'sombre';
      if (themeIcon) themeIcon.dataset.icon = dark ? themeIcon.dataset.light : themeIcon.dataset.dark;
    };

    const apply = (theme: Theme) => {
      const followSystem = theme === systemTheme();
      try {
        if (followSystem) localStorage.removeItem('theme');
        else localStorage.setItem('theme', theme);
      } catch {
        // Stockage indisponible (navigation privée…) : le choix vaut pour cette page.
      }
      if (followSystem) delete root.dataset.theme;
      else root.dataset.theme = theme;
      for (const meta of metas) meta.content = followSystem ? (meta.dataset.color ?? '') : color(theme);
      sync();
    };

    themeButton.addEventListener('click', () => apply(currentTheme() === 'dark' ? 'light' : 'dark'));
    systemDark.addEventListener('change', sync);
    sync();
  }

  // Menu du téléphone : se referme avec Échap, en touchant à côté ou en suivant un lien.
  const header = document.querySelector<HTMLElement>('.site-header');
  const menuButton = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = header?.querySelector<HTMLElement>('#menu');

  if (header && menuButton && menu) {
    const isOpen = () => menuButton.getAttribute('aria-expanded') === 'true';
    const toggle = (open: boolean) => menuButton.setAttribute('aria-expanded', String(open));

    menuButton.addEventListener('click', () => toggle(!isOpen()));
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) toggle(false);
    });
    document.addEventListener('click', (event) => {
      if (event.target === header || !header.contains(event.target as Node)) toggle(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !isOpen()) return;
      toggle(false);
      menuButton.focus();
    });
    header.addEventListener('focusout', (event) => {
      if (event.relatedTarget && !header.contains(event.relatedTarget as Node)) toggle(false);
    });
    window.matchMedia('(max-width: 860px)').addEventListener('change', () => toggle(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--hue);
    /* Évite un liseré d'un pixel entre le menu et l'aplat de la page. */
    box-shadow: 0 1px 0 var(--hue);
    color: var(--hue-ink);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75rem;
    width: min(100% - 2 * var(--gutter), var(--container));
    min-height: 72px;
    margin-inline: auto;
  }

  .nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.85rem;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav a:hover,
  .bar-button:hover {
    background: color-mix(in srgb, var(--hue-ink) 12%, transparent);
    color: var(--hue-ink);
  }

  .nav .brand {
    gap: 0.55rem;
    margin: 0 auto 0 -0.5rem;
    padding: 0 0.5rem;
    font-family: var(--font-title);
    font-size: 1.4rem;
    font-weight: 400;
  }

  .nav-links {
    display: flex;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a[aria-current] {
    background: var(--hue-ink);
    color: var(--hue);
  }

  .bar-button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: none;
    color: var(--hue-ink);
    font-size: 1.15rem;
    cursor: pointer;
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 860px) {
    .nav {
      column-gap: 0.25rem;
      min-height: 64px;
    }

    :global(.js) .nav {
      flex-wrap: nowrap;
    }

    .theme-toggle {
      order: 1;
    }

    /* Sans JavaScript, les liens restent affichés sous le nom. */
    .nav-links {
      order: 3;
      flex-wrap: wrap;
      width: 100%;
      margin-inline: -0.85rem;
    }

    :global(.js) .menu-toggle {
      display: grid;
      order: 2;
      margin-right: -0.6rem;
      font-size: 1.5rem;
    }

    .menu-toggle[aria-expanded='false'] .when-open,
    .menu-toggle[aria-expanded='true'] .when-closed {
      display: none;
    }

    :global(.js) .nav-links {
      position: absolute;
      top: calc(100% - 1px);
      right: 0;
      left: 0;
      display: none;
      width: auto;
      max-height: calc(100vh - var(--header-height));
      max-height: calc(100dvh - var(--header-height));
      margin: 0;
      padding: 0.25rem var(--gutter) 1.5rem;
      border-radius: 0 0 var(--round) var(--round);
      background: var(--hue);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    :global(.js) .menu-toggle[aria-expanded='true'] ~ .nav-links {
      display: block;
    }

    :global(.js) .nav-links a {
      min-height: 60px;
      margin-inline: -0.85rem;
      font-family: var(--font-title);
      font-size: 2.1rem;
      font-weight: 400;
      line-height: 1.1;
    }

    /* Le reste de la page est assombri et ne défile plus. */
    .site-header:has([aria-expanded='true'])::after {
      content: '';
      position: fixed;
      inset: var(--header-height) 0 0;
      z-index: -1;
      background: rgba(16, 13, 16, 0.6);
    }

    :global(html:has([data-menu-toggle][aria-expanded='true'])) {
      overflow: hidden;
    }
  }

  @media (max-width: 350px) {
    .nav .brand {
      gap: 0.4rem;
      font-size: 1.25rem;
    }
  }

  /* Téléphone couché : tous les liens tiennent sans défiler. */
  @media (max-width: 860px) and (max-height: 440px) {
    :global(.js) .nav-links {
      padding-bottom: 0.5rem;
    }

    :global(.js) .nav-links a {
      min-height: 46px;
      font-size: 1.6rem;
    }
  }

  @media (max-width: 860px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .menu-toggle[aria-expanded='true'] ~ .nav-links {
      animation: unfold 0.22s ease-out;
    }

    @keyframes unfold {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }
</style>
