---
// Le menu reprend l'interface du jeu : des mots posés directement sur le sol, au-dessus de la table.
import { navLinks, profile } from '../data/profile';
import Icon from './Icon.astro';
import { icon } from '../lib/icons';

const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---

<header class="site-header">
  <nav class="nav" aria-label="Menu principal">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>Maxime Miguet</a>
    <ul class="nav-links">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={current(link.href)}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={profile.cvPdf} download={profile.cvFileName}><Icon name="download" class="cv-icon" />CV<span class="visually-hidden"> en PDF</span></a>
      </li>
    </ul>
    <button class="theme-toggle" type="button" data-theme-toggle>
      <Icon name="dark_mode" data-light={icon('light_mode').char} data-dark={icon('dark_mode').char} />
      <span>Thème <span data-theme-name>sombre</span></span>
    </button>
  </nav>
</header>

<script>
  // Thème clair ou sombre. Par défaut, celui du navigateur (aucun attribut data-theme). Le choix
  // est retenu dans le navigateur ; revenir au thème du navigateur efface ce choix, et le site
  // suit de nouveau ses changements.
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeName = document.querySelector<HTMLElement>('[data-theme-name]');
  const themeIcon = themeButton?.querySelector<HTMLElement>('.icon');

  if (themeButton && themeName) {
    const root = document.documentElement;
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
    const colors = { light: '#46535d', dark: '#151b20' };
    type Theme = keyof typeof colors;

    const systemTheme = (): Theme => (systemDark.matches ? 'dark' : 'light');
    const currentTheme = (): Theme => (root.dataset.theme === 'dark' || root.dataset.theme === 'light' ? root.dataset.theme : systemTheme());

    // Le bouton annonce le thème qu'il va mettre.
    const sync = () => {
      const dark = currentTheme() === 'dark';
      themeName.textContent = dark ? 'clair' : 'sombre';
      if (themeIcon) themeIcon.dataset.icon = dark ? themeIcon.dataset.light : themeIcon.dataset.dark;
    };

    const apply = (theme: Theme) => {
      const followSystem = theme === systemTheme();
      try {
        if (followSystem) localStorage.removeItem('theme');
        else localStorage.setItem('theme', theme);
      } catch {
        // Stockage indisponible (navigation privée…) : le choix vaut pour cette page.
      }
      if (followSystem) delete root.dataset.theme;
      else root.dataset.theme = theme;
      for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
        meta.content = followSystem ? colors[meta.media.includes('dark') ? 'dark' : 'light'] : colors[theme];
      }
      sync();
    };

    themeButton.addEventListener('click', () => apply(currentTheme() === 'dark' ? 'light' : 'dark'));
    systemDark.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--floor);
    /* Le bord de la table. */
    border-bottom: 10px solid var(--wood);
    color: var(--floor-ink);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1.75rem;
    width: min(100% - 2 * var(--gutter), var(--container));
    min-height: 56px;
    margin-inline: auto;
  }

  .nav a,
  .theme-toggle {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.2rem 0 0;
    border: 0;
    background: none;
    color: var(--floor-ink);
    font-family: var(--font-title);
    font-size: 1.05rem;
    text-decoration: none;
    cursor: pointer;
  }

  .nav a:hover,
  .theme-toggle:hover {
    color: var(--label);
  }

  .nav :focus-visible {
    outline-color: var(--label);
  }

  .nav .brand {
    margin-right: auto;
    font-size: 1.3rem;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a[aria-current] {
    color: var(--label);
  }

  .nav a,
  .theme-toggle {
    gap: 0.4rem;
  }

  /* Special Elite est posée un peu bas : l'icône est remontée d'autant. */
  .nav :global(.icon) {
    position: relative;
    top: -0.1em;
  }

  /* Sur téléphone, les liens passent sur une deuxième ligne : pas de menu à déplier. */
  @media (max-width: 820px) {
    .nav {
      column-gap: 0.5rem;
    }

    .nav-links {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .nav-links a {
      font-family: var(--font-sans);
      font-size: 1rem;
      padding: 0;
    }

    /* Pas la place pour une icône sur cette ligne. */
    .nav :global(.cv-icon) {
      display: none;
    }

    .theme-toggle {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 350px) {
    .theme-toggle :global(.icon) {
      display: none;
    }
  }
</style>
