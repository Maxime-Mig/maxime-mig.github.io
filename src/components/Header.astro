---
// Menu toujours visible, de la couleur de la page.
import { navLinks, profile } from '../data/profile';
import CookieMark from './CookieMark.astro';
import Icon from './Icon.astro';
import { icon } from '../lib/icons';

const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---

<header class="site-header">
  <nav class="nav" aria-label="Menu principal">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}><CookieMark size={36} /><span>Maxime Miguet</span></a>
    <ul class="nav-links">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={current(link.href)}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={profile.cvPdf} download={profile.cvFileName}>CV<span class="visually-hidden"> en PDF</span></a>
      </li>
    </ul>
    <button class="theme-toggle" type="button" data-theme-toggle>
      <Icon name="dark_mode" data-light={icon('light_mode').char} data-dark={icon('dark_mode').char} />
      <span class="visually-hidden">Passer au thème <span data-theme-name>sombre</span></span>
    </button>
  </nav>
</header>

<script>
  // Thème clair ou sombre. Par défaut, celui du navigateur (aucun attribut data-theme). Le choix
  // est retenu dans le navigateur ; revenir au thème du navigateur efface ce choix, et le site
  // suit de nouveau ses changements.
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeName = document.querySelector<HTMLElement>('[data-theme-name]');
  const themeIcon = themeButton?.querySelector<HTMLElement>('.icon');

  if (themeButton && themeName) {
    const root = document.documentElement;
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
    const metas = [...document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')];
    type Theme = 'light' | 'dark';
    const color = (theme: Theme) => metas.find((meta) => meta.media.includes(theme))?.dataset.color ?? '';

    const systemTheme = (): Theme => (systemDark.matches ? 'dark' : 'light');
    const currentTheme = (): Theme => (root.dataset.theme === 'dark' || root.dataset.theme === 'light' ? root.dataset.theme : systemTheme());

    // Le bouton annonce le thème qu'il va mettre.
    const sync = () => {
      const dark = currentTheme() === 'dark';
      themeName.textContent = dark ? 'clair' : 'sombre';
      if (themeIcon) themeIcon.dataset.icon = dark ? themeIcon.dataset.light : themeIcon.dataset.dark;
    };

    const apply = (theme: Theme) => {
      const followSystem = theme === systemTheme();
      try {
        if (followSystem) localStorage.removeItem('theme');
        else localStorage.setItem('theme', theme);
      } catch {
        // Stockage indisponible (navigation privée…) : le choix vaut pour cette page.
      }
      if (followSystem) delete root.dataset.theme;
      else root.dataset.theme = theme;
      for (const meta of metas) meta.content = followSystem ? (meta.dataset.color ?? '') : color(theme);
      sync();
    };

    themeButton.addEventListener('click', () => apply(currentTheme() === 'dark' ? 'light' : 'dark'));
    systemDark.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--hue);
    /* Évite un liseré d'un pixel entre le menu et l'aplat de la page. */
    box-shadow: 0 1px 0 var(--hue);
    color: var(--hue-ink);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75rem;
    width: min(100% - 2 * var(--gutter), var(--container));
    min-height: 72px;
    margin-inline: auto;
  }

  .nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.85rem;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav a:hover,
  .theme-toggle:hover {
    background: color-mix(in srgb, var(--hue-ink) 12%, transparent);
    color: var(--hue-ink);
  }

  .nav .brand {
    gap: 0.55rem;
    margin: 0 auto 0 -0.5rem;
    padding: 0 0.5rem;
    font-family: var(--font-title);
    font-size: 1.4rem;
    font-weight: 400;
  }

  .nav-links {
    display: flex;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a[aria-current] {
    background: var(--hue-ink);
    color: var(--hue);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: none;
    color: var(--hue-ink);
    font-size: 1.15rem;
    cursor: pointer;
  }

  /* Sur téléphone, les liens passent sur une deuxième ligne : pas de menu à déplier. */
  @media (max-width: 820px) {
    .nav {
      min-height: 100px;
      align-content: center;
    }

    .nav-links {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 0;
    }

    .nav-links a {
      min-height: 40px;
      padding: 0 0.55rem;
      font-size: 1rem;
    }

    .nav-links li:first-child a {
      margin-left: -0.55rem;
    }

    .nav-links li:last-child a {
      margin-right: -0.55rem;
    }
  }

  @media (max-width: 430px) {
    .nav-links a {
      padding: 0 0.35rem;
      font-size: 0.95rem;
    }

    .nav-links li:first-child a {
      margin-left: -0.35rem;
    }

    .nav-links li:last-child a {
      margin-right: -0.35rem;
    }
  }

  @media (max-width: 350px) {
    .nav-links a {
      padding: 0 0.2rem;
      font-size: 0.85rem;
    }
  }
</style>
