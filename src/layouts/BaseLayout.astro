---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { hues, type Hue } from '../data/hues';

interface Props {
  title: string;
  description: string;
  /** Couleur de la page. */
  hue?: Hue;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: string;
}

const {
  title,
  description,
  hue = 'rose',
  image = '/og-image.png',
  imageAlt = 'Nom de Maxime Miguet à côté d’un fortune cookie, d’un doigt qui va le casser et d’un pigeon',
  type = 'website',
  noindex = false,
  jsonLd,
  publishedTime,
} = Astro.props;

const site = Astro.site ?? new URL('https://maxime-mig.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
// Le nom n'est ajouté que si le titre reste lisible en entier dans les résultats de recherche (70 caractères environ).
const titleSuffix = ' · Maxime Miguet';
const fullTitle = title.includes('Maxime Miguet') || title.length + titleSuffix.length > 70 ? title : title + titleSuffix;
const ogImage = new URL(image, site).href;
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const keywords =
  'Maxime Miguet, portfolio, développeur jeux vidéo, développeur web, Godot, Vue.js, Node.js, WordPress, BUT Informatique, IUT Nord Franche-Comté, Belfort, étudiant-entrepreneur, Fortune Cookie';
---

<!doctype html>
<html lang="fr" data-hue={hue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Maxime Miguet" />
    <meta name="keywords" content={keywords} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={hues[hue].light} data-color={hues[hue].light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={hues[hue].dark} data-color={hues[hue].dark} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Maxime Miguet · Portfolio" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <slot name="head" />
    <!-- Avant l'affichage : thème choisi avec le bouton de l'en-tête, sinon celui du navigateur. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') return;
        root.dataset.theme = theme;
        const metas = [...document.querySelectorAll('meta[name="theme-color"]')];
        const { color } = metas.find((meta) => meta.media.includes(theme)).dataset;
        for (const meta of metas) meta.content = color;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
